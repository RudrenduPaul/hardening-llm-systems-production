# ─────────────────────────────────────────────────────────────────────────────
# Hardening LLM Systems in Production — API keys template
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# .env is in .gitignore — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Providers (Ch 2, 3, 6, 9, 11) ───────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Vector Stores (Ch 5) ─────────────────────────────────────────────────────
PINECONE_API_KEY=...
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=...
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=...

# ── Observability (Ch 8, 11) ─────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Arize Phoenix (Ch 8) ─────────────────────────────────────────────────────
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ── LLM Gateway (Ch 11) ──────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-...
PORTKEY_API_KEY=...

# ── Signing Keys (Ch 5, 10) ──────────────────────────────────────────────────
# Used for provenance HMAC signatures — any random 32-char string
PROVENANCE_SIGNING_KEY=change-me-to-a-random-32-char-string

# ── Database (Ch 5) ──────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://user:password@localhost:5432/ragdb
